# ─── 分析/写作模型(默认 deepseek/deepseek-chat;可切换任意内置模型)────
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# ─── API Key(按所选 provider 提供;留空时由前端用户输入)────
DEEPSEEK_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# ─── Web 搜索(可选;配置后走 SerpAPI,否则免费降级链 Bing → DuckDuckGo → 兜底)────
# ImportYeti 直连失败时,工具会用它做 site:importyeti.com 等降级检索
SERPAPI_KEY=

# ─── Web 服务端口(后端;开发态 Vite 在 5173,生产态单端口)────────────
PORT=3013
