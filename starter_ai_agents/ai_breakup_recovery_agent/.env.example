# ─── 陪伴模型(默认 deepseek/deepseek-chat;上传截图时请切换多模态模型,
#     如 google/gemini-2.0-flash、openai/gpt-4o-mini)────────────────────
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# ─── API Key(按所选 provider 提供;留空时由前端用户输入)────
DEEPSEEK_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# ─── Web 搜索(可选;毒舌真相 Agent 使用,配置后走 SerpAPI,
#     否则免费降级链 Bing → DuckDuckGo → 兜底)────────────────────
SERPAPI_KEY=

# ─── Web 服务端口(后端;开发态 Vite 在 5173,生产态单端口)────────────
PORT=3008
