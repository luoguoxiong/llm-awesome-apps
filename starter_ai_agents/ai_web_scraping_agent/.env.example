# ─── 抽取模型(默认 deepseek/deepseek-chat;纯文本抽取任务,任意内置模型均可)────
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# ─── API Key(按所选 provider 提供;留空时由前端用户输入)────
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# ─── 网页抓取(可选;配置后优先走 Firecrawl 高质量抓取,否则免费降级链 原生 fetch → 兜底)────
FIRECRAWL_API_KEY=

# ─── Web 服务端口(后端;开发态 Vite 在 5173,生产态单端口)────────────
PORT=3004
