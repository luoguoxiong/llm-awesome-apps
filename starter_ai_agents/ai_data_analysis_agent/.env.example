# ─── 数据分析模型(默认 deepseek/deepseek-chat;源分析应用用 gpt-4o,可切换 openai/gpt-4o)────
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# ─── API Key(按所选 provider 提供;留空时由前端用户输入)────
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# ─── Web 服务端口(后端;开发态 Vite 在 5173,生产态单端口)────────────
PORT=3006
