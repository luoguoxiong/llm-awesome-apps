# ─── 聚合模型(MoA 第三阶段;默认 deepseek/deepseek-chat)────
# 源应用用 Together AI 的 Mixtral-8x22B;本实现模型无关,可任意切换
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# ─── API Key(按所选 provider 提供;留空时由前端用户输入)────
DEEPSEEK_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# ─── Web 服务端口(后端;开发态 Vite 在 5173,生产态单端口)────────────
PORT=3008
