# ─── 编排 LLM(负责润色音乐提示词与对话;源应用用 OpenAI gpt-4o,可切 openai/gpt-4o 等价体验)────
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# ─── LLM API Key(按所选 provider 提供;留空时由前端用户输入)────
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
MOONSHOT_API_KEY=

# ─── ModelsLab 音乐生成(必填;获取:https://modelslab.com/dashboard/api-keys)────
MODELSLAB_API_KEY=

# ─── Web 服务端口(后端;开发态 Vite 在 5173,生产态单端口)────────────
PORT=3011
