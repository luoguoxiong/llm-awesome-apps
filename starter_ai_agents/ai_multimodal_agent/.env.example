# ─── 多模态分析模型(默认 google/gemini-2.5-flash;需选择 input 含 image 的模型)────
# 可选:openai/gpt-4o-mini、anthropic/claude-3-5-sonnet-20241022、xai/grok-3-mini、openrouter/auto 等
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash

# ─── API Key(按所选 provider 提供;留空时由前端用户输入)────
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# ─── Web 搜索(可选;配置后走 SerpAPI,否则免费降级链 Bing → DuckDuckGo)────
SERPAPI_KEY=

# ─── Web 服务端口(后端;开发态 Vite 在 5173,生产态单端口)────────────
PORT=3003
