# ─── 普通模型(默认 deepseek;可选 openai / anthropic / google / groq 等)────
LLM_PROVIDER=deepseek
# 模型 id(留空则按 provider 取默认:deepseek→deepseek-chat,openai→gpt-4o-mini)
LLM_MODEL=

# ─── 推理模型(默认 deepseek/deepseek-reasoner;也可选 gpt-5 / o3 / gemini-2.5-pro 等)────
REASONING_PROVIDER=deepseek
REASONING_MODEL=deepseek-reasoner

# ─── API Key(按所选 provider 提供;留空时由前端用户输入)────
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# ─── Web 服务端口(后端;开发态 Vite 在 5173,生产态单端口)────────────
PORT=3002
