# ─── 问答模型（默认 deepseek/deepseek-chat；源应用用 Claude 3 Opus，可切换 anthropic/claude-3-5-sonnet-latest）────
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# ─── API Key（按所选 provider 提供；留空时由前端用户输入）────
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# ─── 可选：Firecrawl 抓取 Key（URL 摄取优先走 Firecrawl，未配置时用原生 fetch + HTML 正文提取）────
FIRECRAWL_API_KEY=

# ─── 检索参数 ────────────────────────────────────────────────
# 混合检索候选数（融合后送入 LLM 重排的片段数）
CANDIDATE_K=10
# 最终注入上下文的片段数
CONTEXT_K=5
# RRF 融合常数（越大名次差异影响越小）
RRF_K=60
# 是否启用 LLM 相关性重排（false 时直接用融合分数取 top-k）
GRADE_ENABLED=true

# ─── 索引持久化目录（JSON 文件，重启不丢）────────────────────
VECTOR_DB_DIR=.aipack/hybrid-rag-store

# ─── Web 服务端口（后端；开发态 Vite 在 5173，生产态单端口）────
PORT=3014
