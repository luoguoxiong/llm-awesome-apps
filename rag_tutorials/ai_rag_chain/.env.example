# ─── RAG 生成模型(默认 deepseek/deepseek-chat;源应用为 gemini-1.5-pro,可切换 google/gemini-2.0-flash)────
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat

# ─── API Key(按所选 provider 提供;留空时由前端用户输入)────
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# ─── 检索参数 ─────────────────────────────────────────────
# 检索片段数(与源应用 as_retriever(k=5) 对齐,范围 1-10)
RAG_TOP_K=5
# 知识库持久化目录(默认 app 根目录下 .rag-store/)
VECTOR_DB_DIR=

# ─── Web 服务端口(后端;开发态 Vite 在 5173,生产态单端口)────────────
PORT=3013
